<?xml version="1.0" encoding="utf-8"?>
<FDL version="2.1">
  <Form id="stock0104pu" width="540" height="470" titletext="입금 출금" background="transParent" border="0px none" onload="stock0104pu_onload">
    <Layouts>
      <Layout height="470" width="540">
        <Div id="divPopup" taborder="0" left="20" top="20" width="500" height="430" cssclass="div_popup" boxShadow="0px 0px transParent">
          <Layouts>
            <Layout>
              <Static id="Static00" taborder="0" text="입출금 계좌" left="173" top="40" width="167" height="30" cssclass="sta_puHead" onclick="divPopup_Static00_onclick" textAlign="center"/>
              <Static id="staName" taborder="1" text="학생이름" left="170" top="80" width="170" height="20" cssclass="sta_puExplain" onclick="divPopup_Static01_onclick" textAlign="center"/>
              <Static id="Static02" taborder="2" text="입금" left="38" top="119" width="112" height="21" cssclass="sta_puSub" onclick="divPopup_Static02_onclick"/>
              <Static id="Static02_00" taborder="3" text="출금" left="38" top="239" width="132" height="21" cssclass="sta_puSub"/>
              <Button id="btnSave" taborder="4" text="이체" left="181" top="345" width="138" height="51" cssclass="btn_puSave" onclick="divPopup_btnSave_onclick"/>
              <Button id="btnClose" taborder="5" left="444" top="20" width="33" height="34" cssclass="btn_puClose" text="" onclick="divPopup_btnClose_onclick"/>
              <MaskEdit id="mEditValueMinus" taborder="6" left="38" top="270" width="425" height="52" cssclass="mEdit_pu" format="#,#.##" displaynulltext="ex) 10,000" textAlign="left" oninput="divPopup_mEditValueMinus_oninput"/>
              <MaskEdit id="mEditValuePlus" taborder="7" left="38" top="154" width="425" height="52" cssclass="mEdit_pu" format="#,#.##" displaynulltext="ex) 10,000" textAlign="left" oninput="divPopup_mEditValuePlus_oninput"/>
            </Layout>
          </Layouts>
        </Div>
      </Layout>
    </Layouts>
    <Objects>
      <Dataset id="ds_account">
        <ColumnInfo>
          <Column id="MONEY" type="INT" size="256"/>
          <Column id="USER_ID" type="INT" size="256"/>
        </ColumnInfo>
      </Dataset>
    </Objects>
    <Script type="xscript5.1"><![CDATA[this.stock0104pu_onload = function(obj:nexacro.Form,e:nexacro.LoadEventInfo)
{
	var objParam1 = this.parent.param1; //sUserId
	var objParam2 = this.parent.param2; //sUserName
	this.divPopup.form.staName.text = objParam2;
	
	this.ds_account.clearData();
	this.ds_account.addRow();
	this.ds_account.setColumn(0,"USER_ID", objParam1);
};


//저장
this.divPopup_btnSave_onclick = function(obj:nexacro.Button,e:nexacro.ClickEventInfo)
{		
		this.saveTransaction();
};
//팝업 닫기
this.divPopup_btnClose_onclick = function(obj:nexacro.Button,e:nexacro.ClickEventInfo)
{
		this.close();
};

this.saveTransaction = function ()
{		
	var nPlus  = nexacro.toNumber(this.divPopup.form.mEditValuePlus.value) || 0;
    var nMinus = nexacro.toNumber(this.divPopup.form.mEditValueMinus.value) || 0;
    
    if (nPlus > 0) {
        this.ds_account.setColumn(0, "MONEY", nPlus);
    } 
   
    else if (nMinus > 0) {
        this.ds_account.setColumn(0, "MONEY", -nMinus); 
    }
		
		var strSvcId    = "update";
		var strSvcUrl   = "user/updateAccount.do";
		var inData      = "ds_account=ds_account:u";
		var outData     = "";
		var sParam      = "";
		var callBackFnc = "fn_callback";

		this.gfnTransaction(strSvcId ,
							strSvcUrl ,
							inData ,
							outData ,
							sParam,
							callBackFnc);
};


this.fn_callback = function(svcID, errCode, errMsg) {
	this.close();
}



this.divPopup_mEditValuePlus_oninput = function(obj:nexacro.MaskEdit,e:nexacro.InputEventInfo)
{
	if(this.divPopup.form.mEditValuePlus.value){
		this.divPopup.form.mEditValueMinus.enable = false;	
	}
	else{
		this.divPopup.form.mEditValueMinus.enable = true;
	}
};

this.divPopup_mEditValueMinus_oninput = function(obj:nexacro.MaskEdit,e:nexacro.InputEventInfo)
{
	if(this.divPopup.form.mEditValueMinus.value){
		this.divPopup.form.mEditValuePlus.enable = false;	
	}
	else{
		this.divPopup.form.mEditValuePlus.enable = true;
	}
};
]]></Script>
    <Bind>
      <BindItem id="item0" compid="divPopup.form.Static00" propid="text" datasetid="ds_copyStock" columnid="TITLE"/>
      <BindItem id="item5" compid="divPopup.form.mEditValueMinus" propid="value" datasetid="ds_uploadValue" columnid="CURRENT_VALUE"/>
      <BindItem id="item1" compid="divPopup.form.mEditValuePlus" propid="value" datasetid="ds_uploadValue" columnid="CURRENT_VALUE"/>
    </Bind>
  </Form>
</FDL>

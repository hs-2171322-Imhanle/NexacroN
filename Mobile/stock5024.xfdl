    <Script type="xscript5.1"><![CDATA[
this.stock5024_onload = function(obj:nexacro.Form,e:nexacro.LoadEventInfo)
{
	this.divPay_btnBuy_onclick();
	var nStockId = this.parent.select_stockId;
    
    if (nStockId) {
        this.stockLoad(nStockId);
		this.accountLoad(nStockId);
    }
};
/************transaction*************/
this.stockLoad = function(nStockId){
	
	this.ds_search.clearData();
	var nRow = this.ds_search.addRow();
	
	this.ds_search.setColumn(nRow,"pStock_Id", nStockId)
	var objApp = nexacro.getApplication();
	var sUserId = objApp.gds_user.getColumn(objApp.gds_user.rowposition,"USER_ID");
	this.ds_search.setColumn(this.ds_search.rowposition,"USER_ID",sUserId); 
	
 	var strSvcId    = "searchStock";
	var strSvcUrl   = "stock/loadStockOne.do";
	var inData      = "ds_search=ds_search gds_user=gds_user";
	var outData     = "ds_stock=ds_stock ds_value=ds_value ds_news=ds_news";
	var sParam      = "";
	var callBackFnc = "fnCallback";
	var isAsync   	= true;   
	
	this.gfnTransaction(strSvcId , 		
						strSvcUrl , 	
						inData , 		
						outData , 		
						sParam, 		
						callBackFnc, 	
						isAsync); 		
}
this.accountLoad = function(){
	

 	var strSvcId    = "searchAccount";
	var strSvcUrl   = "stock/loadAccount.do";
	var inData      = "ds_search=ds_search";
	var outData     = "ds_account=ds_account ds_holding=ds_holding";
	var sParam      = "";
	var callBackFnc = "fnCallback";
	var isAsync   	= true;
	
	this.gfnTransaction(strSvcId , 		
						strSvcUrl , 	
						inData , 		
						outData , 		
						sParam, 		
						callBackFnc, 	
						isAsync); 		
}
this.updateAccount =function()
{
	var strSvcId    = "updateAccount";
	var strSvcUrl   = "stock/updateAccount.do";
	var inData      = "ds_search=ds_search gds_user=gds_user ds_account=ds_account:u ds_holding=ds_holding:u";
	var outData     = "";
	var sParam      = "";
	var callBackFnc = "fnCallback";
	var isAsync   	= true;
	
	this.gfnTransaction(strSvcId , 		
						strSvcUrl , 	
						inData , 		
						outData , 		
						sParam, 		
						callBackFnc, 	
						isAsync); 	
}


this.fnCallback = function(svcId) 
{	
	if(svcId =="searchStock"){
		var findRate = this.ds_stock.getColumn(0, "CALCULATED_RATE");
		var rateNum = parseFloat(findRate);
		var prefix = (findRate > 0) ? "▲" : (findRate < 0 ? "▼" : "");
		
		this.staRate.text=prefix + Math.abs(findRate) + "%";
		this.staRate.color='rgba(252, 170, 37, 1)';
		
		var value = this.ds_stock.getColumn(0, "CURRENT_VALUE");
		let tLength = nexacro.getTextSize(String(value), "bold 18px/normal Malgun Gothic");
		this.maskValue.width = tLength.nx+50;
		this.maskValue.value = value;
		
		var unitId = this.ds_stock.getColumn(0, "UNIT_ID");
		var nTargetRow = this.ds_unit.findRow("ID", unitId);
		if (nTargetRow != -1) {
			var unitName = this.ds_unit.getColumn(nTargetRow, "UNIT");
			this.staUnit.text=unitName;
		} else {
			this.staUnit.text="₩"; 
		}
		
		this.divChart.form.fnCreateChart();
		this.Div01.form.divNews.form.fnCreateNewsCards();
		this.fnCalculateHolding();
	}
	if(svcId == "searchAccount"){
		if(this.ds_holding.rowcount == 0) {	
			this.ds_holding.addRow();
		}
		this.fnCalculateHolding();
	}
	if (svcId == "updateAccount")
	{
		this.accountLoad();
	}
	this.resetScroll();
}


//++++++++++++++++++++++++++++++++++++++++++
this.divPay_btnBuy_onclick = function(obj:nexacro.Button,e:nexacro.ClickEventInfo)
{
	this.divPay.form.btnBuy.cssclass="btn_buy_pushed";
 	this.divPay.form.btnSell.cssclass="btn_sell";
 	this.divPay.form.StaExplain.text = "몇 주를 살까요?"
	this.divPay.form.btnSelect.cssclass = "btn_buy_pushed"
	this.divPay.form.btnSelect.text = "지금 바로 매수하기"
	this.divPay.form.maskValuePay.value = 100;
	this.divPay.form.staShare.text = 1;
	
	
};
this.divPay_btnSell_onclick = function(obj:nexacro.Button,e:nexacro.ClickEventInfo)
{
	var evalMoney = this.ds_holding.getColumn(0,"EVAL_MONEY");
	var quantity = this.ds_holding.getColumn(0,"QUANTITY");
	
	this.divPay.form.btnSell.cssclass="btn_sell_pushed";
 	this.divPay.form.btnBuy.cssclass="btn_buy";
 	this.divPay.form.StaExplain.text = "몇 주를 팔까요?"
	this.divPay.form.btnSelect.cssclass = "btn_sell_pushed"
	this.divPay.form.btnSelect.text = "지금 바로 매도하기"
	this.divPay.form.maskValuePay.value = evalMoney/quantity;
	this.divPay.form.staShare.text = 1;
};
this.divPay_btnPlus_onclick = function(obj:nexacro.Button,e:nexacro.ClickEventInfo)
{
	var sCurrentValue = this.divPay.form.staShare.text;
	var nValue = nexacro.toNumber(sCurrentValue);
	
	var evalMoney = this.ds_holding.getColumn(0,"EVAL_MONEY");
	var quantity = this.ds_holding.getColumn(0,"QUANTITY");
	 
	if(nValue != 100){
		if(this.divPay.form.btnSelect.text == "지금 바로 매수하기"){
			var nNewValue = nValue + 1;
			this.divPay.form.staShare.text = nNewValue;
			var calculate = nNewValue *100;
			var sDisplayPrice = calculate.toLocaleString();
			let tLength = nexacro.getTextSize(sDisplayPrice, "bold 20px/normal Malgun Gothic");
			this.divPay.form.maskValuePay.left = 261 - (tLength.nx+50);
			this.divPay.form.maskValuePay.value = calculate;
		}
		else{
			var nNewValue = nValue + 1;
			this.divPay.form.staShare.text = nNewValue;
			var calculate = nNewValue *(evalMoney/quantity);
			var sDisplayPrice = calculate.toLocaleString();
			let tLength = nexacro.getTextSize(sDisplayPrice, "bold 20px/normal Malgun Gothic");
			this.divPay.form.maskValuePay.left = 261 - (tLength.nx+50);
			this.divPay.form.maskValuePay.value = calculate;
		}
	}
	this.resetScroll();
};

this.divPay_btnMinus_onclick = function(obj:nexacro.Button,e:nexacro.ClickEventInfo)
{
	var sCurrentValue = this.divPay.form.staShare.text;
	var nValue = nexacro.toNumber(sCurrentValue);
	 
	var evalMoney = this.ds_holding.getColumn(0,"EVAL_MONEY");
	var quantity = this.ds_holding.getColumn(0,"QUANTITY");
	
	if(nValue >0){
		if(this.divPay.form.btnSelect.text == "지금 바로 매수하기"){
			var nNewValue = nValue - 1;
			this.divPay.form.staShare.text = nNewValue;
			var calculate = nNewValue * 100;
			var sDisplayPrice = calculate.toLocaleString();
			let tLength = nexacro.getTextSize(sDisplayPrice, "bold 20px/normal Malgun Gothic");
			this.divPay.form.maskValuePay.left = 261 - (tLength.nx+50);
			this.divPay.form.maskValuePay.value = calculate;
		}
		else{
			var nNewValue = nValue - 1;
			this.divPay.form.staShare.text = nNewValue;
			var calculate = nNewValue *(evalMoney/quantity);
			var sDisplayPrice = calculate.toLocaleString();
			let tLength = nexacro.getTextSize(sDisplayPrice, "bold 20px/normal Malgun Gothic");
			this.divPay.form.maskValuePay.left = 261 - (tLength.nx+50);
			this.divPay.form.maskValuePay.value = calculate;
		}
	}
	this.resetScroll();
};

this.divPay_btnSelect_onclick = function(obj:nexacro.Button,e:nexacro.ClickEventInfo)
{
	var nShare = nexacro.toNumber(this.divPay.form.staShare.text);
	var currentVal = nexacro.toNumber(this.ds_stock.getColumn(0, "CURRENT_VALUE"));
	var sType      = this.ds_stock.getColumn(0, "STOCK_TYPE");
	
	var money      = nexacro.toNumber(this.ds_account.getColumn(0, "MONEY"));
	var holdingQty = nexacro.toNumber(this.ds_holding.getColumn(0, "QUANTITY")) || 0;
	var payAmount = (sType == 'R') ? (nShare * 100) : (nShare * currentVal);
	
    if(this.divPay.form.btnSelect.text == "지금 바로 매수하기") {
		if(money >= payAmount) {
			this.buyPopup(nShare);
		}	
	}
    else { 
		if(holdingQty >= nShare && holdingQty > 0) {
			this.sellPopup(nShare);
		}
	}
};

this.fnCalculateHolding = function()
{
    if(this.ds_holding.rowcount == 0 || this.ds_stock.rowcount == 0) return;

    var sType      = this.ds_stock.getColumn(0, "STOCK_TYPE");
    var nCurVal    = nexacro.toNumber(this.ds_stock.getColumn(0, "CURRENT_VALUE"));
    var nRate      = nexacro.toNumber(this.ds_stock.getColumn(0, "RATE"));
    
    var nQty       = nexacro.toNumber(this.ds_holding.getColumn(0, "QUANTITY"));
    var nAvgWeight = nexacro.toNumber(this.ds_holding.getColumn(0, "HOLDING_VALUE"));
    
    var nProfitRate = 0; //주식 수익률
    var nEvalMoney  = 0; //평가금액
	
    if(nQty > 0) { // [수익률,평가금액 계산]
		var nTotalInvest = nQty * 100;
        if(sType == 'R') {
            nProfitRate = (nCurVal - nAvgWeight) * nRate;
			nEvalMoney = Math.round(nTotalInvest + (nTotalInvest * (nProfitRate / 100)));
			this.ds_holding.setColumn(0, "TOTAL_INVEST", nTotalInvest);
        } else {
			nEvalMoney = nQty * nCurVal;
            if(nAvgWeight > 0) {
                nProfitRate = ((nCurVal - nAvgWeight) / nAvgWeight) * 100;
            }
			this.ds_holding.setColumn(0, "TOTAL_INVEST", nQty * nAvgWeight);
        }
        
        // 5. 계산 결과 세팅
        this.ds_holding.setColumn(0, "PROFIT_RATE", nProfitRate.toFixed(2));
        this.ds_holding.setColumn(0, "EVAL_MONEY", nEvalMoney);
 
    } else {
        // 보유 수량이 0인 경우 초기화
        this.ds_holding.setColumn(0, "PROFIT_RATE", 0);
        this.ds_holding.setColumn(0, "EVAL_MONEY", 0);
        this.ds_holding.setColumn(0, "TOTAL_INVEST", 0);
    }
};

this.buyPopup = function (nShare)
{
	var title = this.ds_stock.getColumn(0,"TITLE");
	
	var sPopupId = "popupBuy";
	var sUrl  = "Popup::mStock1000pu.xfdl";
	var oArg ={param1:title ,param2:nShare};
	var oOption = {title:"모달팝업", titlebar:false};
	var sPopupCallBack = "fn_callbackPopup"; //close 할때, 호출
	this.gfnOpenPopup( sPopupId,sUrl,oArg,sPopupCallBack,oOption);
};
this.sellPopup = function (nShare)
{
	var title = this.ds_stock.getColumn(0,"TITLE");
	
	var sPopupId = "popupSell";
	var sUrl  = "Popup::mStock1001pu.xfdl";
	var oArg ={param1:title ,param2:nShare};
	var oOption = {title:"모달팝업", titlebar:false};
	var sPopupCallBack = "fn_callbackPopup"; //close 할때, 호출
	this.gfnOpenPopup( sPopupId,sUrl,oArg,sPopupCallBack,oOption);
};

this.fn_callbackPopup = function(svcId, rtn)
{
	var nShare = nexacro.toNumber(this.divPay.form.staShare.text);
	var currentVal = nexacro.toNumber(this.ds_stock.getColumn(0, "CURRENT_VALUE"));
	var sType      = this.ds_stock.getColumn(0, "STOCK_TYPE");
	var nRate      = nexacro.toNumber(this.ds_stock.getColumn(0, "RATE"));
	
	var money      = nexacro.toNumber(this.ds_account.getColumn(0, "MONEY"));
	var holdingQty = nexacro.toNumber(this.ds_holding.getColumn(0, "QUANTITY")) || 0;
	var avgWeight  = nexacro.toNumber(this.ds_holding.getColumn(0, "HOLDING_VALUE")) || 0;
	var evalMoney = this.ds_holding.getColumn(0,"EVAL_MONEY");
			
	if(svcId =="popupBuy"){
		if(rtn =="okay"){
			var payAmount = (sType == 'R') ? (nShare * 100) : (nShare * currentVal);
        
			// 잔고 차감
			this.ds_account.setColumn(0, "MONEY", money - payAmount);
			
			var totalQty = holdingQty + nShare;
			// 평단가(가중 평균) 계산
			var newAvgWeight = ((avgWeight * holdingQty) + (currentVal * nShare)) / totalQty;
			
			this.ds_holding.setColumn(0, "QUANTITY", totalQty);
			this.ds_holding.setColumn(0, "HOLDING_VALUE", newAvgWeight);
			
			// [원금 세팅]
			// 기록형: 주수 * 100 / 주식형: 주수 * 평단가
			var nTotalInvest = (sType == 'R') ? (totalQty * 100) : (totalQty * newAvgWeight);
			this.ds_holding.setColumn(0, "TOTAL_INVEST", nTotalInvest);
			
			this.updateAccount();
		}
	}
	
	if (svcId == "popupSell")
	{
		if(rtn == "okay"){
			
			var sellMoney = 0;

			if(sType == 'R') {
				// [기록형 매도 핵심 수정]
				var pricePerShare = evalMoney / holdingQty;
				sellMoney = Math.floor(nShare * pricePerShare);
			} else {
				// [주식형 매도] : 실제 시장가(현재가) 그대로
				sellMoney = nShare * currentVal;
			}

			// 계좌 잔고 업데이트
			this.ds_account.setColumn(0, "MONEY", money + sellMoney);

			// [사용자 시나리오 복기] : 매도 시 평단가(avgWeight)는 유지, 주수와 원금만 감소
			var remainQty = holdingQty - nShare;
			this.ds_holding.setColumn(0, "QUANTITY", remainQty);
			
			// 원금(Principal) 감소: 판 주수만큼 100원(혹은 평단가)씩 제거
			if(sType == 'R') {
				this.ds_holding.setColumn(0, "TOTAL_INVEST", remainQty * 100);
				
			} else {
				this.ds_holding.setColumn(0, "TOTAL_INVEST", remainQty * avgWeight);
			}

			// 전량 매도 시 초기화
			if(remainQty <= 0) {
				this.ds_holding.setColumn(0, "HOLDING_VALUE", 0);
				this.ds_holding.setColumn(0, "QUANTITY", 0);
				this.ds_holding.setColumn(0, "TOTAL_INVEST", 0);
			}
			this.updateAccount();
		}
	}
}

this.Div01_divNews_onclick = function(obj:nexacro.Div,e:nexacro.ClickEventInfo)
{
	this.Div01.form.divNews.form.stockSub5030_onclick();
};
this.btnBack_onclick = function(obj:nexacro.Button,e:nexacro.ClickEventInfo)
{	
	this.parent.url="Mobile::stock5022.xfdl";
};]]></Script>

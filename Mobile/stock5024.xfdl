        </ColumnInfo>
      </Dataset>
    </Objects>
    <Bind>
      <BindItem id="item0" compid="Static00" propid="text" datasetid="ds_stock" columnid="TITLE"/>
      <BindItem id="item1" compid="Static01" propid="text" datasetid="ds_stock" columnid="TICKER_SYMBOL"/>
      <BindItem id="item2" compid="divPay.form.maskValue00_00" propid="value" datasetid="ds_account" columnid="MONEY"/>
      <BindItem id="item3" compid="divPay.form.maskValue00_00_00" propid="value" datasetid="ds_holding" columnid="QUANTITY"/>
      <BindItem id="item5" compid="divPay.form.maskValue00_00_01" propid="value" datasetid="ds_holding" columnid="EVAL_MONEY"/>
    </Bind>
  </Form>

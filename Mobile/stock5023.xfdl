    <Objects>
      <Dataset id="ds_myStock">
        <ColumnInfo>
          <Column id="TITLE" type="STRING" size="256"/>
          <Column id="IMAGE_DATA" type="STRING" size="256"/>
          <Column id="UNIT_ID" type="INT" size="256"/>
          <Column id="CURRENT_VALUE" type="BIGDECIMAL" size="256"/>
          <Column id="CALCULATED_RATE" type="STRING" size="256"/>
          <Column id="STOCK_ID" type="INT" size="256"/>
          <Column id="TICKER_SYMBOL" type="STRING" size="256"/>
          <Column id="STOCK_TYPE" type="STRING" size="256"/>
          <Column id="SUBTITLE" type="STRING" size="256"/>
          <Column id="RATE" type="STRING" size="256"/>
        </ColumnInfo>
      </Dataset>
      <Dataset id="ds_search">
        <ColumnInfo>
          <Column id="ROLE" type="STRING" size="256"/>
          <Column id="USER_ID" type="STRING" size="256"/>
        </ColumnInfo>
        <Rows>
          <Row/>
        </Rows>
      </Dataset>
      <Dataset id="ds_account">
        <ColumnInfo>
          <Column id="MONEY" type="INT" size="256"/>
        </ColumnInfo>
      </Dataset>
      <Dataset id="ds_holding" useclientlayout="true">
        <ColumnInfo>
          <Column id="HOLDING_VALUE" type="FLOAT" size="256"/>
          <Column id="TOTAL_INVEST" type="INT" size="256"/>
          <Column id="QUANTITY" type="STRING" size="256"/>
          <Column id="EVAL_MONEY" type="INT" size="256"/>
          <Column id="PROFIT_RATE" type="FLOAT" size="256"/>
          <Column id="STOCK_ID" type="INT" size="256"/>
        </ColumnInfo>
      </Dataset>
      <Dataset id="ds_unit">
        <ColumnInfo>
          <Column id="ID" type="INT" size="256"/>
          <Column id="UNIT" type="STRING" size="256"/>
        </ColumnInfo>
        <Rows>
          <Row>
            <Col id="ID">1</Col>
            <Col id="UNIT">Kg</Col>
          </Row>
          <Row>
            <Col id="ID">2</Col>
            <Col id="UNIT">개</Col>
          </Row>
          <Row>
            <Col id="ID">3</Col>
            <Col id="UNIT">걸음</Col>
          </Row>
        </Rows>
      </Dataset>
      <Dataset id="ds_combined">
        <ColumnInfo>
          <Column id="TITLE" type="STRING" size="256"/>
          <Column id="IMAGE_DATA" type="STRING" size="256"/>
          <Column id="UNIT_NAME" type="STRING" size="256"/>
          <Column id="TICKER_SYMBOL" type="STRING" size="256"/>
          <Column id="HOLDING_VALUE" type="FLOAT" size="256"/>
          <Column id="QUANTITY" type="STRING" size="256"/>
          <Column id="EVAL_MONEY" type="INT" size="256"/>
          <Column id="PROFIT_RATE" type="FLOAT" size="256"/>
          <Column id="STOCK_ID" type="INT" size="256"/>
        </ColumnInfo>
      </Dataset>
    </Objects>
    <Script type="xscript5.1"><![CDATA[this.stock5023_onload = function(obj:nexacro.Form,e:nexacro.LoadEventInfo)
{	
	var objApp = nexacro.getApplication();
	var sUserId = objApp.gds_user.getColumn(objApp.gds_user.rowposition,"USER_ID");
	var sUserRole = objApp.gds_user.getColumn(objApp.gds_user.rowposition, "ROLE");
	this.ds_search.setColumn(this.ds_search.rowposition,"USER_ID",sUserId); 
	this.ds_search.setColumn(this.ds_search.rowposition,"ROLE",sUserRole); 
	this.accountLoad();
};

this.Button00_onclick = function(obj:nexacro.Button,e:nexacro.ClickEventInfo)
{
	this.Div00_00_01_00_00.form.Static00.text = this.gfnAppendComma(50000000, 0);
};




this.accountLoad = function(){
 	var strSvcId    = "searchMyAsset";
	var strSvcUrl   = "stock/loadMyAssets.do";
	var inData      = "ds_search=ds_search";
	var outData     = "ds_account=ds_account ds_holding=ds_holding ds_myStock=ds_myStock";
	var sParam      = "";
	var callBackFnc = "fnCallback";
	var isAsync   	= true;
	
	this.gfnTransaction(strSvcId , 		
						strSvcUrl , 	
						inData , 		
						outData , 		
						sParam, 		
						callBackFnc, 	
						isAsync); 		
}
this.fnCallback = function(svcId) 
{
	if(svcId == "searchMyAsset"){
		this.fnCalculateTotalAsset();
		this.ds_combined.clearData();
    
		for(var i=0; i<this.ds_holding.rowcount; i++)
		{
			var nRow = this.ds_combined.addRow();
			var nStockId = this.ds_holding.getColumn(i, "STOCK_ID");
			
		
			this.ds_combined.copyRow(nRow, this.ds_holding, i);
			var nFindRow = this.ds_myStock.findRow("STOCK_ID", nStockId);
			if(nFindRow != -1) {
				this.ds_combined.setColumn(nRow, "TITLE", this.ds_myStock.getColumn(nFindRow, "TITLE"));
				this.ds_combined.setColumn(nRow, "IMAGE_DATA", this.ds_myStock.getColumn(nFindRow, "IMAGE_DATA"));
				this.ds_combined.setColumn(nRow, "TICKER_SYMBOL", this.ds_myStock.getColumn(nFindRow, "TICKER_SYMBOL"));
				
				var nUnitId = this.ds_myStock.getColumn(nRow, "UNIT_ID");
				var nUnitRow = this.ds_unit.findRow("ID", nUnitId);
				if(nUnitRow != -1) {
					var sUnitNm = this.ds_unit.getColumn(nUnitRow, "UNIT");
					this.ds_combined.setColumn(nRow, "UNIT_NAME", sUnitNm); 
				}
				else{
					this.ds_combined.setColumn(nRow, "UNIT_NAME", "₩"); 
				}
			}
		}
	}
}
this.Button01_onclick = function(obj:nexacro.Button,e:nexacro.ClickEventInfo)
{
	this.parent.url = "Mobile::stock5020.xfdl";
};

this.fnCalculateTotalAsset = function()
{
    var nTotalInvest = 0; // 총 투자 원금
    var nTotalEval   = 0; // 총 평가 금액
    
    var nCnt = this.ds_holding.rowcount;
 
    for(var i=0; i<nCnt; i++) {
        var nStockId = this.ds_holding.getColumn(i, "STOCK_ID");
        var nQty     = nexacro.toNumber(this.ds_holding.getColumn(i, "QUANTITY"));
        
        // 보유 수량이 없으면 스킵
        if(nQty <= 0) {
            this.ds_holding.setColumn(i, "PROFIT_RATE", 0);
            this.ds_holding.setColumn(i, "EVAL_MONEY", 0);
            this.ds_holding.setColumn(i, "TOTAL_INVEST", 0);
            continue;
        }

        var sType      = this.ds_myStock.lookup("STOCK_ID", nStockId, "STOCK_TYPE");
        var nCurVal    = nexacro.toNumber(this.ds_myStock.lookup("STOCK_ID", nStockId, "CURRENT_VALUE"));
        var nRate      = nexacro.toNumber(this.ds_myStock.lookup("STOCK_ID", nStockId, "RATE"));
        var nAvgWeight = nexacro.toNumber(this.ds_holding.getColumn(i, "HOLDING_VALUE"));

        var nEvalMoney  = 0;
        var nRowInvest  = 0;
        var nProfitRate = 0; // 개별 종목 수익률

        // --- 수익률 및 금액 계산 분기 ---
        if(sType == 'R') { 
            // 1. 기록형 (원금 100원 고정 기준)
            nRowInvest = nQty * 100; 
            nProfitRate = (nCurVal - nAvgWeight) * nRate;
            nEvalMoney = Math.round(nRowInvest + (nRowInvest * (nProfitRate / 100)));
        } 
        else { 
            // 2. 주식형 (매수 평단가 기준)
            nRowInvest = nQty * nAvgWeight; 
            nEvalMoney = nQty * nCurVal;
            if(nAvgWeight > 0) {
                nProfitRate = ((nCurVal - nAvgWeight) / nAvgWeight) * 100;
            } else {
                nProfitRate = 0;
            }
        }

        // --- 데이터셋 세팅 (현재 행 i에 세팅) ---
        this.ds_holding.setColumn(i, "PROFIT_RATE", nProfitRate.toFixed(2));
        this.ds_holding.setColumn(i, "EVAL_MONEY", nEvalMoney);
        this.ds_holding.setColumn(i, "TOTAL_INVEST", nRowInvest);

		nTotalInvest += nRowInvest;
        nTotalEval   += nEvalMoney;
    }
    
    var nProfitWon = nTotalEval - nTotalInvest;
	
	this.Div00_00_01_00_00_01.form.maskStockValue.value = nTotalEval;
	this.Div00_00_01_00_00_02.form.maskStockRate.value = nProfitWon;
	
	if(nProfitWon <0){
		this.Div00_00_01_00_00_02.background = "rgba(219,219,255,0.65)";
		this.Div00_00_01_00_00_02.border = "5px solid #fffff"
		this.Div00_00_01_00_00_02.borderRadius = "50px";
		//this.Div00_00_01_00_00_02.boxShadow = "0px 15px 0px 0px #b5b3f9";
	}
	else{
		this.Div00_00_01_00_00_02.background = "RGBA(255,219,219,0.65)";
		this.Div00_00_01_00_00_02.border = "5px solid #fffff"
		this.Div00_00_01_00_00_02.borderRadius = "50px";
	//	this.Div00_00_01_00_00_02.boxShadow = "0px 15px 0px 0px #ffb1af";
	}
	
};



this.btnBack_onclick = function(obj:nexacro.Button,e:nexacro.ClickEventInfo)
{
	this.parent.url = "Mobile::stock5020.xfdl";
};
]]></Script>
    <Bind>
      <BindItem id="item0" compid="Div00_00_01_00_00.form.maskMoney" propid="value" datasetid="ds_account" columnid="MONEY"/>
    </Bind>
  </Form>
</FDL>

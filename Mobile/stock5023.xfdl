              <Static id="Static00_00" taborder="1" text="보유 종목 상세" left="80" top="10" width="224" height="60" color="black" font="bold 20px/normal &quot;Malgun Gothic&quot;"/>
              <Static id="Static03" taborder="2" text="    종목&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9; &#9;&#9;   보유량&#9;&#9;&#9;&#9;    평균단가&#9;&#9;&#9;&#9;수익률&#9;&#9;&#9;  평가금액&#9;" left="0" top="71" height="47" right="0" background="#faefe9" border="1px solid #fcf9f7,0px none" onclick="Div01_Static03_onclick" font="bold 12px/normal &quot;Malgun Gothic&quot;"/>
              <ListView id="ListView00" taborder="1" left="0" top="Static03:0" binddataset="ds_combined" right="0" bottom="0">
                <Formats>
                  <Format id="default">
                    <Band id="body" width="100%" height="80">
                      <Cell id="Cell01" left="95" top="15" width="120" height="24" text="bind:TITLE" font="bold 16px/normal &quot;Malgun Gothic&quot;" color="black" border="0px none"/>
                      <Cell id="Cell03" left="25" top="15" width="50" height="50" text="bind:IMAGE_DATA" border="0px none" borderRadius="20px" displaytype="imagecontrol" imagestretch="fit" background="pink"/>
                      <Cell id="Cell09" left="520" top="28" width="100" height="24" text="bind:HOLDING_VALUE" color="black" font="bold 16px/normal &quot;Malgun Gothic&quot;" border="0px none" textAlign="right"/>
                      <Cell id="Cell05" left="Cell09:0" top="28" width="50" height="24" text="bind:UNIT_NAME" color="black" font="bold 16px/normal &quot;Malgun Gothic&quot;" border="0px none"/>
                      <Cell id="Cell07" left="95" top="37" width="120" height="24" text="bind:TICKER_SYMBOL" font="10px/normal &quot;Malgun Gothic&quot;" color="gray" border="0px none"/>
                      <Cell id="Cell11" left="400" top="28" width="70" height="24" text="bind:QUANTITY" font="bold 16px/normal &quot;Malgun Gothic&quot;" color="black" border="0px none" expr="expr:QUANTITY + &quot;주&quot;" textAlign="center"/>
                      <Cell id="Cell13" left="870" top="28" width="100" height="24" text="expr:EVAL_MONEY + &quot; ₩&quot;" color="black" font="bold 16px/normal &quot;Malgun Gothic&quot;" border="0px none" textAlign="center"/>
                      <Cell id="Cell15" left="720" top="28" width="100" height="24" text="expr:(PROFIT_RATE &gt; 0 ? &quot;▲&quot; : (PROFIT_RATE &lt; 0 ? &quot;▼&quot; : &quot;&quot;)) + Math.abs(PROFIT_RATE) + &quot;%&quot;" color="black" font="bold 16px/normal &quot;Malgun Gothic&quot;" border="0px none" textAlign="center"/>
                    </Band>

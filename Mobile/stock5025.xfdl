<?xml version="1.0" encoding="utf-8"?>
<FDL version="2.1">
  <Form id="stock5025" width="1280" height="800" titletext="매도 매수S" background="#fcf9f7">
    <Layouts>
      <Layout height="800" width="1280">
        <Button id="btnBack" taborder="0" left="29" top="38" width="51" height="51" cssclass="btn_back" onclick="btnBack_onclick"/>
        <Static id="Static00" taborder="1" text="게임 천국" left="109" top="20" width="131" height="60" color="black" font="bold 30px/normal &quot;Malgun Gothic&quot;"/>
        <Static id="Static01" taborder="2" text="3A8B" left="109" top="74" width="48" height="31" color="gray" font="bold 16px/normal &quot;Malgun Gothic&quot;"/>
        <Div id="Div00" taborder="3" left="49" top="130" width="821" height="382" background="white" cssclass="div_stockRoom" border="0px none" boxShadow="0px 15px 0px 0px #ffb787">
          <Layouts>
            <Layout/>
          </Layouts>
        </Div>
        <Div id="Div01" taborder="4" left="50" top="557" width="821" height="193" background="white" cssclass="div_stockRoom" border="0px none" boxShadow="0px 15px 0px 0px #ffb787">
          <Layouts>
            <Layout>
              <Static id="Static00" taborder="0" text="오늘의 뉴스" left="58" top="23" width="113" height="47" color="black" font="bold 20px/normal &quot;Malgun Gothic&quot;"/>
              <Static id="Static01" taborder="1" left="17" top="33" width="40" height="27" background="url('theme::p02_thema/NewFolder/newspaper.png') no-repeat center center /contain" text=""/>
              <Div id="Div00" taborder="2" left="24" top="72" width="773" height="83" background="#fcf9f7" borderRadius="30px"/>
            </Layout>
          </Layouts>
        </Div>
        <Div id="Div02" taborder="5" text="Div02" left="907" top="130" width="333" height="373" background="#1E293b" borderRadius="30px" boxShadow="0px 15px 0px 0px #000000">
          <Layouts>
            <Layout>
              <Static id="Static00" taborder="0" text="다른 친구들은 얼마에 사나요?" left="56" top="32" width="171" height="17" color="white"/>
              <Static id="Static01" taborder="1" left="26" top="30" width="20" height="20" background="url('theme::p02_thema/NewFolder/reporter.png') no-repeat center center /contain"/>
              <Static id="Static02" taborder="2" left="26" top="170" width="283" height="1" background="white"/>
              <Static id="Static02_00" taborder="3" left="26" top="219" width="283" height="1" background="white"/>
            </Layout>
          </Layouts>
        </Div>
        <Div id="Div01_00" taborder="6" left="920" top="130" width="302" height="590" background="white" cssclass="div_stockRoom" border="0px none" boxShadow="0px 15px 0px 0px #ffb787">
          <Layouts>
            <Layout>
              <Static id="Static00" taborder="0" left="26" top="33" width="250" height="47" background="#fcf9f7" borderRadius="20px"/>
              <Button id="btnBuy" taborder="1" text="매수" left="24" top="33" width="125" height="46" cssclass="btn_buy" onclick="Div01_00_btnBuy_onclick"/>
              <Button id="btnSell" taborder="2" text="매도" left="151" top="33" width="125" height="46" cssclass="btn_sell" onclick="Div01_00_btnSell_onclick"/>
              <Static id="StaExplain" taborder="3" text="몇 주를 살까요?" left="113" top="101" width="95" height="22" font="12px/normal &quot;Malgun Gothic&quot;" color="gray"/>
              <Button id="btnMinus" taborder="4" text="-" left="26" top="136" width="48" height="48" cssclass="btn_minus" onclick="Div01_00_btnMinus_onclick"/>
              <Button id="btnPlus" taborder="5" text="+" left="228" top="136" width="48" height="48" cssclass="btn_minus" onclick="Div01_00_btnPlus_onclick"/>
              <Static id="staShare" taborder="6" text="1" left="100" top="130" width="55" height="60" font="bold 36px/normal &quot;Malgun Gothic&quot;" textAlign="right"/>
              <Static id="Static03" taborder="7" text="주" left="164" top="147" width="32" height="27" font="bold 18px/normal &quot;Malgun Gothic&quot;" color="gray"/>
              <Static id="Static03_00" taborder="8" left="24" top="212" width="252" height="112" background="#fcf9f7" borderRadius="30px" text=""/>
              <Static id="StaExplain2" taborder="9" text="내 지갑 잔액" left="41" top="235" width="95" height="20" font="12px/normal &quot;Malgun Gothic&quot;" color="gray"/>
              <Static id="Static01" taborder="10" left="41" top="261" width="221" height="1" border="1px solid #c1c1c1"/>
              <Static id="Static02" taborder="11" text="합계" left="40" top="276" width="51" height="29" color="black" font="bold 20px/normal &quot;Malgun Gothic&quot;"/>
              <Static id="staUnit" taborder="13" text="₩" top="268" height="44" color="black" font="bold 20px/normal &quot;Malgun Gothic&quot;" textAlign="right" left="170" right="108"/>
              <MaskEdit id="maskValue00" taborder="12" top="261" height="59" format="#,##0" enable="true" readonly="true" textAlign="right" border="0px none" font="bold 20px/normal &quot;Malgun Gothic&quot;" color="black" displaynulltext="0" cssclass="mask_money" width="78" limitbymask="none" left="staUnit:-12" background="transParent"/>
            </Layout>
          </Layouts>
        </Div>
      </Layout>
    </Layouts>
    <Objects>
      <Dataset id="ds_stock">
        <ColumnInfo>
          <Column id="TITLE" type="STRING" size="256"/>
          <Column id="IMAGE_DATA" type="STRING" size="256"/>
          <Column id="UNIT_ID" type="INT" size="256"/>
          <Column id="CURRENT_VALUE" type="BIGDECIMAL" size="256"/>
          <Column id="CALCULATED_RATE" type="STRING" size="256"/>
          <Column id="STOCK_ID" type="INT" size="256"/>
          <Column id="TICKER_SYMBOL" type="STRING" size="256"/>
          <Column id="STOCK_TYPE" type="STRING" size="256"/>
        </ColumnInfo>
      </Dataset>
      <Dataset id="ds_value">
        <ColumnInfo>
          <Column id="VALUE_ID" type="INT" size="256"/>
          <Column id="STOCK_ID" type="INT" size="256"/>
          <Column id="DAY_SEQ" type="DATE" size="256"/>
          <Column id="CURRENT_VALUE" type="BIGDECIMAL" size="256"/>
        </ColumnInfo>
      </Dataset>
      <Dataset id="ds_pagingInfo">
        <ColumnInfo>
          <Column id="totalCount" type="STRING" size="256"/>
        </ColumnInfo>
      </Dataset>
      <Dataset id="ds_search">
        <ColumnInfo>
          <Column id="records" type="INT" size="256"/>
          <Column id="page" type="INT" size="256"/>
          <Column id="recordsOffset" type="INT" size="256"/>
          <Column id="pageCount" type="INT" size="256"/>
          <Column id="pStock_Id" type="STRING" size="256"/>
        </ColumnInfo>
      </Dataset>
    </Objects>
    <Bind>
      <BindItem id="item0" compid="Static00" propid="text" datasetid="ds_stock" columnid="TITLE"/>
      <BindItem id="item1" compid="Static01" propid="text" datasetid="ds_stock" columnid="TICKER_SYMBOL"/>
    </Bind>
    <Script type="xscript5.1"><![CDATA[this.btnBack_onclick = function(obj:nexacro.Button,e:nexacro.ClickEventInfo)
{	
	this.parent.url="Mobile::stock5022.xfdl";
};

this.Div01_00_btnBuy_onclick = function(obj:nexacro.Button,e:nexacro.ClickEventInfo)
{
	this.Div01_00.form.btnBuy.cssclass="btn_buy_pushed";
 	this.Div01_00.form.btnSell.cssclass="btn_sell";
 	this.Div01_00.form.StaExplain.text = "얼마를 살까요?"
	this.Div01_00.form.StaExplain2.text = "내 지갑 잔액"
	
};

this.Div01_00_btnSell_onclick = function(obj:nexacro.Button,e:nexacro.ClickEventInfo)
{
	this.Div01_00.form.btnSell="btn_sell_pushed";
 	this.Div01_00.form.btnBuy.cssclass="btn_buy";
 	this.Div01_00.form.StaExplain.text = "얼마를 팔까요?"
	this.Div01_00.form.StaExplain2.text = "내 가진 주식"
};

this.Div01_00_btnMinus_onclick = function(obj:nexacro.Button,e:nexacro.ClickEventInfo)
{	
	var sCurrentValue = this.Div01_00.form.staShare.text;
	var nValue = parseInt(sCurrentValue)
	 
	if(nValue != 1){
		var nNewValue = nValue - 1;
		this.Div01_00.form.staShare.text = nNewValue;
		let tLength = nexacro.getTextSize(nNewValue, "bold 20px/normal Malgun Gothic");
		this.maskValue00.width = tLength.nx+50;
		this.maskValue00.value = value;
	}
	this.resetScroll();
};

this.Div01_00_btnPlus_onclick = function(obj:nexacro.Button,e:nexacro.ClickEventInfo)
{
	var sCurrentValue = this.Div01_00.form.staShare.text;
	var nValue = parseInt(sCurrentValue)
	 
	if(nValue != 100){
		var nNewValue = nValue + 1;
		this.Div01_00.form.staShare.text = nNewValue;
		let tLength = nexacro.getTextSize(nNewValue, "bold 20px/normal Malgun Gothic");
		this.maskValue00.width = tLength.nx+50;
		this.maskValue00.value = value;
	}
	this.resetScroll();
};]]></Script>
  </Form>
</FDL>

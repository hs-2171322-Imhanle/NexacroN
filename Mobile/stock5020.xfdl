    <Objects>
      <Dataset id="ds_myStock">
        <ColumnInfo>
          <Column id="TITLE" type="STRING" size="256"/>
          <Column id="IMAGE_DATA" type="STRING" size="256"/>
          <Column id="UNIT_ID" type="INT" size="256"/>
          <Column id="CURRENT_VALUE" type="BIGDECIMAL" size="256"/>
          <Column id="CALCULATED_RATE" type="STRING" size="256"/>
          <Column id="STOCK_ID" type="INT" size="256"/>
          <Column id="TICKER_SYMBOL" type="STRING" size="256"/>
          <Column id="STOCK_TYPE" type="STRING" size="256"/>
          <Column id="SUBTITLE" type="STRING" size="256"/>
          <Column id="RATE" type="STRING" size="256"/>
        </ColumnInfo>
      </Dataset>
      <Dataset id="ds_value">
        <ColumnInfo>
          <Column id="VALUE_ID" type="INT" size="256"/>
          <Column id="STOCK_ID" type="INT" size="256"/>
          <Column id="DAY_SEQ" type="DATE" size="256"/>
          <Column id="CURRENT_VALUE" type="BIGDECIMAL" size="256"/>
        </ColumnInfo>
      </Dataset>
      <Dataset id="ds_search">
        <ColumnInfo>
          <Column id="ROLE" type="STRING" size="256"/>
          <Column id="USER_ID" type="STRING" size="256"/>
        </ColumnInfo>
        <Rows>
          <Row/>
        </Rows>
      </Dataset>
      <Dataset id="ds_account">
        <ColumnInfo>
          <Column id="MONEY" type="INT" size="256"/>
        </ColumnInfo>
      </Dataset>
      <Dataset id="ds_holding" useclientlayout="true">
        <ColumnInfo>
          <Column id="HOLDING_VALUE" type="FLOAT" size="256"/>
          <Column id="TOTAL_INVEST" type="INT" size="256"/>
          <Column id="QUANTITY" type="STRING" size="256"/>
          <Column id="EVAL_MONEY" type="INT" size="256"/>
          <Column id="PROFIT_RATE" type="FLOAT" size="256"/>
          <Column id="STOCK_ID" type="INT" size="256"/>
        </ColumnInfo>
      </Dataset>
      <Dataset id="ds_stock">
        <ColumnInfo>
          <Column id="TITLE" type="STRING" size="256"/>
          <Column id="IMAGE_DATA" type="STRING" size="256"/>
          <Column id="UNIT_ID" type="INT" size="256"/>
          <Column id="CURRENT_VALUE" type="BIGDECIMAL" size="256"/>
          <Column id="CALCULATED_RATE" type="STRING" size="256"/>
          <Column id="STOCK_ID" type="INT" size="256"/>
          <Column id="TICKER_SYMBOL" type="STRING" size="256"/>
          <Column id="STOCK_TYPE" type="STRING" size="256"/>
          <Column id="SUBTITLE" type="STRING" size="256"/>
          <Column id="RATE" type="STRING" size="256"/>
        </ColumnInfo>
      </Dataset>
    </Objects>
    <Script type="xscript5.1"><![CDATA[this.stock5020_onload = function(obj:nexacro.Form,e:nexacro.LoadEventInfo)
{
	var objApp = nexacro.getApplication();
	var sUserId = objApp.gds_user.getColumn(objApp.gds_user.rowposition,"USER_ID");
	var sUserRole = objApp.gds_user.getColumn(objApp.gds_user.rowposition, "ROLE");
	this.ds_search.setColumn(this.ds_search.rowposition,"USER_ID",sUserId); 
	this.ds_search.setColumn(this.ds_search.rowposition,"ROLE",sUserRole); 
	this.accountLoad();
	this.stockLoad();
};
this.btnStockAll_onclick = function(obj:nexacro.Button,e:nexacro.ClickEventInfo)
{	
	this.parent.url="Mobile::stock5022.xfdl";
};

this.accountLoad = function(){
 	var strSvcId    = "searchMyAsset";
	var strSvcUrl   = "stock/loadMyAssets.do";
	var inData      = "ds_search=ds_search";
	var outData     = "ds_account=ds_account ds_holding=ds_holding ds_myStock=ds_myStock";
	var sParam      = "";
	var callBackFnc = "fnCallback";
	var isAsync   	= true;
	
	this.gfnTransaction(strSvcId , 		
						strSvcUrl , 	
						inData , 		
						outData , 		
						sParam, 		
						callBackFnc, 	
						isAsync); 		
}
this.stockLoad = function(){
 	var strSvcId    = "searchRecommandStock";
	var strSvcUrl   = "stock/loadRecommandStock.do";
	var inData      = "ds_search=ds_search";
	var outData     = "ds_stock=ds_stock ds_value=ds_value";
	var sParam      = "";
	var callBackFnc = "fnCallback";
	var isAsync   	= true;
	
	this.gfnTransaction(strSvcId , 		
						strSvcUrl , 	
						inData , 		
						outData , 		
						sParam, 		
						callBackFnc, 	
						isAsync); 		
}

this.fnCallback = function(svcId)
{
	if(svcId =="searchMyAsset"){
		this.fnCalculateTotalAsset();
		this.fnCalculateAssetRatio();
		this.drawMyStock();
	}
	if(svcId == "searchRecommandStock"){
		this.drawStock();
	}
}


this.fnCalculateTotalAsset = function()
{
    var nTotalInvest = 0; // 총 투자 원금
    var nTotalEval   = 0; // 총 평가 금액
    
    var nCnt = this.ds_holding.rowcount;
 
    for(var i=0; i<nCnt; i++) {
        var nStockId = this.ds_holding.getColumn(i, "STOCK_ID");
        var nQty     = nexacro.toNumber(this.ds_holding.getColumn(i, "QUANTITY"));
        
        // 보유 수량이 없으면 스킵
        if(nQty <= 0) {
            this.ds_holding.setColumn(i, "PROFIT_RATE", 0);
            this.ds_holding.setColumn(i, "EVAL_MONEY", 0);
            this.ds_holding.setColumn(i, "TOTAL_INVEST", 0);
            continue;
        }

        var sType      = this.ds_myStock.lookup("STOCK_ID", nStockId, "STOCK_TYPE");
        var nCurVal    = nexacro.toNumber(this.ds_myStock.lookup("STOCK_ID", nStockId, "CURRENT_VALUE"));
        var nRate      = nexacro.toNumber(this.ds_myStock.lookup("STOCK_ID", nStockId, "RATE"));
        var nAvgWeight = nexacro.toNumber(this.ds_holding.getColumn(i, "HOLDING_VALUE"));

        var nEvalMoney  = 0;
        var nRowInvest  = 0;
        var nProfitRate = 0; // 개별 종목 수익률

        // --- 수익률 및 금액 계산 분기 ---
        if(sType == 'R') { 
            // 1. 기록형 (원금 100원 고정 기준)
            nRowInvest = nQty * 100; 
            nProfitRate = (nCurVal - nAvgWeight) * nRate;
            nEvalMoney = Math.round(nRowInvest + (nRowInvest * (nProfitRate / 100)));
        } 
        else { 
            // 2. 주식형 (매수 평단가 기준)
            nRowInvest = nQty * nAvgWeight; 
            nEvalMoney = nQty * nCurVal;
            if(nAvgWeight > 0) {
                nProfitRate = ((nCurVal - nAvgWeight) / nAvgWeight) * 100;
            } else {
                nProfitRate = 0;
            }
        }

        // --- 데이터셋 세팅 (현재 행 i에 세팅) ---
        this.ds_holding.setColumn(i, "PROFIT_RATE", nProfitRate.toFixed(2));
        this.ds_holding.setColumn(i, "EVAL_MONEY", nEvalMoney);
        this.ds_holding.setColumn(i, "TOTAL_INVEST", nRowInvest);

        // --- 전체 합산 데이터 누적 ---
        nTotalInvest += nRowInvest;
        nTotalEval   += nEvalMoney;
    }
    
    // --- 상단 UI 마스크 및 라벨 업데이트 ---
    var nProfitWon = nTotalEval - nTotalInvest;
    
    this.Div00.form.maskStockValue.value = nTotalEval;
    
    // 수익금액 텍스트 사이즈 계산 및 너비 조정
    let tLength = nexacro.getTextSize(String(nProfitWon), "14px/normal Malgun Gothic");
    this.Div00.form.maskUpValue.width = tLength.nx + 50;
    this.Div00.form.maskUpValue.value = nProfitWon;
    
    this.Div00.form.maskInvest.value = nTotalInvest;
    this.Div00_00_00.form.maskStockValue2.value = nTotalEval;
    
    //this.resetScroll();
};
//현금자산
this.fnCalculateAssetRatio = function()
{
	var nEvalCnt = this.ds_holding.rowcount;
    var nMoney = nexacro.toNumber(this.ds_account.getColumn(0, "MONEY")) || 0;
	var nEvalMoney =0;
	for(var i=0; i<nEvalCnt;i++){
		nEvalMoney += nexacro.toNumber(this.ds_holding.getColumn(i, "EVAL_MONEY"));
	}
  
    
	//전체자산
    var nTotalAsset = nMoney + nEvalMoney;
    
	//현금 비중(%)
    var nCashRatio = 0;
	var nStockRatio = 0;
    if (nTotalAsset > 0) {
        // 현금 비중(%) = (현금 / 전체자산) * 100
        nCashRatio = Math.floor((nMoney / nTotalAsset) * 100);
		nStockRatio = 100 - nCashRatio;
    }

    this.Div00_01.form.staExplainMoney.text = "전체 자산 중 "+nCashRatio+ "%가 현금 자산이에요.";
	this.Div00_01.form.ProgressBar.pos = nCashRatio;
	
	if(nCashRatio == 100){
		this.Div00_00_00.form.divRatio.form.staMoney.left = 0;
		this.Div00_00_00.form.divRatio.form.staStock.width = 0;
	}
	else if (nCashRatio == 0){
		this.Div00_00_00.form.divRatio.form.staStock.right = 0;
		this.Div00_00_00.form.divRatio.form.staMoney.width = 0;
	}
	else{
		var nStockWidth = Math.floor(710 * (nStockRatio / 100));
        var nMoneyWidth = 710 - nStockWidth; // 합쳐서 nFullWidth가 되도록 나머 할당
        
        // 주식 Static (왼쪽 배치)
        this.Div00_00_00.form.divRatio.form.staStock.set_visible(true);
        this.Div00_00_00.form.divRatio.form.staStock.set_left(0);
        this.Div00_00_00.form.divRatio.form.staStock.set_width(nStockWidth);
        
        // 현금 Static (주식 바로 옆에 배치)
        this.Div00_00_00.form.divRatio.form.staMoney.set_visible(true);
        this.Div00_00_00.form.divRatio.form.staMoney.set_left(nStockWidth + 5); 
        this.Div00_00_00.form.divRatio.form.staMoney.set_width(nMoneyWidth - 5);
	}

};




//drawDiv
this.drawMyStock = function ()
{
	var arrObj = this.divMyStock.form.components;
    for(var i=arrObj.length-1; i>=0; i--) {
        if(arrObj[i].name.indexOf("divCard") == 0) {
            var objDel = this.removeChild(arrObj[i].name);
            objDel.destroy();
        }
    }
	
	var objStock = this.ds_myStock;
	var objHolding = this.ds_holding;
    var nCnt = objStock.getRowCount();
    if (nCnt == 0) return;
	
	var nCardW = 275, nCardH = 61, nGapX = 57, nGapY = 15;
    var nStartX = 25, nStartY = 75
	var nColCnt = 1;
	
	for(var i=0; i < nCnt; i++)
    {
		if(i == 3) break;
        var nRow = Math.floor(i / nColCnt); 
        var nCol = i % nColCnt;         
        var nLeft = nStartX + (nCol * (nCardW + nGapX));
        var nTop  = nStartY + (nRow * (nCardH + nGapY));
        
        var sDivId = "divCard" + i;
        var objDiv = new Div();
        objDiv.init(sDivId, nLeft, nTop, nCardW, nCardH);
		
        
		objDiv.backgroud = "white";
		objDiv.border = "2px dashed #f90000";
		objDiv.borderRadius = "15px";
        objDiv.set_url("MobileSub::stockSub5026.xfdl");
        objDiv.async = false;
        
        this.divMyStock.form.addChild(sDivId, objDiv);
        objDiv.show();
        objDiv.form.fn_initCard(objStock, objHolding,i);
    }
	this.divMyStock.form.staStockCnt.text = nCnt + "종목 보유"
}


this.drawStock = function ()
{
	var arrObj = this.all;
    for(var i=arrObj.length-1; i>=0; i--) {
        if(arrObj[i].name.indexOf("divCard2") == 0) {
            var objDel = this.removeChild(arrObj[i].name);
            objDel.destroy();
        }
    }
	
	var objDs = this.ds_stock;
    var nCnt = objDs.getRowCount();
    if (nCnt == 0) return;
	
	var nCardW = 260, nCardH = 160, nGapX = 34, nGapY = 60;
    var nStartX = 60, nStartY = 570
	var nColCnt = 4;
	
	for(var i=0; i < nCnt; i++)
    {
        var nRow = Math.floor(i / nColCnt); 
        var nCol = i % nColCnt;         
        var nLeft = nStartX + (nCol * (nCardW + nGapX));
        var nTop  = nStartY + (nRow * (nCardH + nGapY));
        
        var sDivId = "divCard2" + i;
        var objDiv = new Div();
        objDiv.init(sDivId, nLeft, nTop, nCardW, nCardH);
		
        
		objDiv.cssclass = "div_stockRoom";
        objDiv.set_url("MobileSub::stockSub5021.xfdl");
        objDiv.async = false;
        
        this.addChild(sDivId, objDiv);
        objDiv.show();
        objDiv.form.fn_initCard(objDs, i);
    }
}
this.fn_divClick = function(nRow)
{
    var nStockId   = this.ds_stock.getColumn(nRow, "STOCK_ID");
    var sStockType = this.ds_stock.getColumn(nRow, "STOCK_TYPE");
	
    var objDiv = this.parent; 
	if(sStockType == "R"){
		objDiv.url = "Mobile::stock5024.xfdl";
	}
	else{
		objDiv.url = "Mobile::stock5024.xfdl";
	}
    objDiv.select_stockId = nStockId;
    
};
this.btnAccount_onclick = function(obj:nexacro.Button,e:nexacro.ClickEventInfo)
{
	this.parent.url ="Mobile::stock5023.xfdl";
};
]]></Script>

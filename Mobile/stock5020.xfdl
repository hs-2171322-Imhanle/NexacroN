      <BindItem id="item0" compid="Div00_01.form.MaskEdit00" propid="value" datasetid="ds_account" columnid="MONEY"/>
      <BindItem id="item1" compid="Div00_00_00.form.MaskEdit00_00_01_00" propid="value" datasetid="ds_account" columnid="MONEY"/>

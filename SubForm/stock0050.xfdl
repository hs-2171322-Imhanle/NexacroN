<?xml version="1.0" encoding="utf-8"?>
<FDL version="2.1">
  <Form id="stock0020" width="1310" height="721" titletext="stockList" onload="form_onload">
    <Layouts>
      <Layout height="721" width="1310">
        <Edit id="editSearch" taborder="4" left="181" top="43" width="309" height="35" cssclass="edit_search" displaynulltext="Search..." onkeyup="editSearch_onkeyup" background="white"/>
        <Div id="Div00" taborder="1" text="Div00" left="60" top="100" width="1195" height="540" background="white" borderRadius="12px" border="1px solid #f7f1ec" boxShadow="0px 2px 2px 0px #e0e0e0" formscrollbartype="none none" formscrolltype="none">
          <Layouts>
            <Layout>
              <Grid id="gridStudent" taborder="0" left="0" top="0" binddataset="ds_stock" autofittype="col" cssclass="grid_basic" background="white" oncellclick="Div00_gridStudent_oncellclick" right="0" bottom="49">
                <Formats>
                  <Format id="default">
                    <Columns>
                      <Column size="30"/>
                      <Column size="30"/>
                      <Column size="50"/>
                      <Column size="95"/>
                      <Column size="68"/>
                      <Column size="48"/>
                      <Column size="95"/>
                      <Column size="95"/>
                      <Column size="70"/>
                    </Columns>
                    <Rows>
                      <Row size="52" band="head"/>
                      <Row size="60"/>
                    </Rows>
                    <Band id="head">
                      <Cell displaytype="checkboxcontrol" text="bind:CHK_DEL" checkboxsize="20" edittype="checkbox"/>
                      <Cell col="1" colspan="2" text="종목이름"/>
                      <Cell col="3" text="종목코드"/>
                      <Cell col="4" colspan="2" text="현재가"/>
                      <Cell col="6" text="1 변화당 수익률"/>
                      <Cell col="7" text="변동률"/>
                      <Cell col="8" text="카테고리"/>
                    </Band>
                    <Band id="body">
                      <Cell edittype="checkbox" displaytype="checkboxcontrol" checkboxsize="20" text="bind:CHK_DEL"/>
                      <Cell col="1" displaytype="imagecontrol" text="bind:IMAGE_DATA" imagestretch="fit"/>
                      <Cell col="2" text="bind:TITLE" textAlign="left"/>
                      <Cell col="3" text="bind:TICKER_SYMBOL"/>
                      <Cell col="4" text="bind:CURRENT_VALUE" textAlign="right"/>
                      <Cell col="5" text="bind:UNIT_NAME" textAlign="left"/>
                      <Cell col="6" text="expr:RATE + &quot;%&quot;" color="#ffa42d"/>
                      <Cell col="7" text="expr:CALCULATED_RATE &gt; 0 ? '+' + CALCULATED_RATE + '%' : CALCULATED_RATE + '%'" cssclass="expr:CALCULATED_RATE &gt; 0 ? 'grid_red' : (CALCULATED_RATE &lt; 0 ? 'grid_blue' : '')"/>
                      <Cell col="8" text="bind:GROUP_NAME" displaytype="buttoncontrol" padding="10px"/>
                    </Band>
                  </Format>
                </Formats>
              </Grid>
              <Div id="divPage" taborder="1" text="Div00" left="55" top="489" width="1073" height="50" url="Cmm::CmmPaging.xfdl" background="transParent"/>
            </Layout>
          </Layouts>
        </Div>
        <Button id="btnDelete" taborder="0" text="종목 삭제" left="1130" top="44" width="105" height="33" cssclass="btn_work_select" onclick="btnDeleteStu_onclick"/>
        <Static id="Static00" taborder="2" text="주식 관리" left="58" top="45" width="106" font="bold 21px/normal &quot;Malgun Gothic&quot;" color="black" height="30"/>
        <Button id="btnSearch" taborder="3" left="192" top="47" width="25" height="26" cssclass="btn_search" onlbuttonup="btnSearch_onlbuttonup"/>
        <CheckBox id="chkAIMODE" taborder="5" left="868" top="44" width="80" height="31" cssclass="chk_WF_Toggle" onclick="chkAIMODE_onclick"/>
        <Static id="Static00_00_02_00" taborder="6" text=" AI 모드" left="868" top="19" width="52" height="22" cssclass="sta_acordian_explain" onclick="divBasic2_Static00_00_onclick"/>
        <Static id="Static00_00_02_00_00" taborder="7" text="9시에 변동 금액 및 &#13;&#10;뉴스카드를 대신 작성해줍니다." left="964" top="45" width="154" height="28" onclick="divBasic2_Static00_00_onclick" font="11px/normal &quot;Malgun Gothic&quot;"/>
      </Layout>
    </Layouts>
    <Objects>
      <Dataset id="ds_stock">
        <ColumnInfo>
          <Column id="IMAGE_DATA" type="STRING" size="256" description="이미지"/>
          <Column id="TITLE" type="STRING" size="256" description="종목 이름"/>
          <Column id="TICKER_SYMBOL" type="STRING" size="256" description="방번호"/>
          <Column id="CURRENT_VALUE" type="BIGDECIMAL" size="256" description="최신 금액(현재금액)"/>
          <Column id="RATE" type="STRING" size="256" description="1 변화당 수익률"/>
          <Column id="CALCULATED_RATE" type="STRING" size="256" description="변동률"/>
          <Column id="SUBTITLE" type="STRING" size="256" description="기록항목"/>
          <Column id="GROUP_ID" type="INT" size="256" description="그룹종목의 아이디"/>
          <Column id="STOCK_ID" type="INT" size="256" description="주식종목의 아이디"/>
          <Column id="AI_MODE" type="INT" size="256" description="AI on/off"/>
          <Column id="UNIT_ID" type="INT" size="256"/>
          <Column id="GROUP_NAME" type="STRING" size="256"/>
          <Column id="UNIT_NAME" type="STRING" size="256"/>
          <Column id="CHK_DEL" type="STRING" size="256"/>
        </ColumnInfo>
      </Dataset>
      <Dataset id="ds_search">
        <ColumnInfo>
          <Column id="records" type="INT" size="256"/>
          <Column id="page" type="INT" size="256"/>
          <Column id="recordsOffset" type="INT" size="256"/>
          <Column id="pageCount" type="INT" size="256"/>
          <Column id="pTitle" type="STRING" size="256"/>
        </ColumnInfo>
      </Dataset>
      <Dataset id="ds_pagingInfo">
        <ColumnInfo>
          <Column id="totalCount" type="STRING" size="256"/>
        </ColumnInfo>
      </Dataset>
      <Dataset id="ds_group">
        <ColumnInfo>
          <Column id="GROUP_ID" type="INT" size="256"/>
          <Column id="GROUP_NAME" type="STRING" size="256"/>
          <Column id="GROUP_CODE" type="STRING" size="256"/>
        </ColumnInfo>
      </Dataset>
      <Dataset id="ds_unit">
        <ColumnInfo>
          <Column id="ID" type="INT" size="256"/>
          <Column id="UNIT" type="STRING" size="256"/>
        </ColumnInfo>
        <Rows>
          <Row>
            <Col id="ID">1</Col>
            <Col id="UNIT">Kg</Col>
          </Row>
          <Row>
            <Col id="ID">2</Col>
            <Col id="UNIT">개</Col>
          </Row>
          <Row>
            <Col id="ID">3</Col>
            <Col id="UNIT">걸음</Col>
          </Row>
        </Rows>
      </Dataset>
      <Dataset id="ds_config">
        <ColumnInfo>
          <Column id="CONFIG_KEY" type="STRING" size="256"/>
          <Column id="CONFIG_VALUE" type="STRING" size="256"/>
          <Column id="USER_ID" type="STRING" size="256"/>
        </ColumnInfo>
        <Rows>
          <Row/>
        </Rows>
      </Dataset>
    </Objects>
    <Script type="xscript5.1"><![CDATA[this.fvApp = nexacro.getApplication();

this.fvRecords=0; 			//목록갯수
this.fvRecords=0;	 			//페이지번호
this.fvRecordsOffset=0;		//시작rownum
this.fvTotalCount=0;		//전체데이터갯수
this.fvPageCount=0; 		//실제표출페이지갯수

this.form_onload = function(obj:nexacro.Form,e:nexacro.LoadEventInfo)
{	
	this.groupLoad();
	this.gfnFormOnLoad(this);
	this.loadAI();
	
};

 this.fnPageInit = function ()
 {
 	//pagin info init setting
	this.fvRecords=7;								 //목록갯수
	this.fvPage=0;	 								 //페이지번호
	this.fvRecordsOffset=0;							 //시작rownum
	this.fvPageCount = 10;							 //실제표출페이지갯수
	
	this.stockLoad();
 };
this.stockLoad = function(){
	
	this.ds_search.clearData();
	var nRow = this.ds_search.addRow();
	
	this.ds_search.setColumn(0,"pTitle", this.editSearch.value);
	this.ds_search.setColumn(nRow, "records", this.fvRecords);
	this.ds_search.setColumn(nRow, "recordsOffset", this.fvRecordsOffset); 

	
 	var strSvcId    = "searchStock";
	var strSvcUrl   = "stock/loadStock.do";
	var inData      = "ds_search=ds_search gds_user=gds_user";
	var outData     = "ds_stock=ds_stock ds_pagingInfo=ds_pagingInfo";
	var sParam      = "";
	var callBackFnc = "fnCallback";
	var isAsync   	= true;
	
	this.gfnTransaction(strSvcId , 		
						strSvcUrl , 	
						inData , 		
						outData , 		
						sParam, 		
						callBackFnc, 	
						isAsync); 		
}
this.saveStock = function()
{		
		var strSvcId    = "saveStock";
		var strSvcUrl   = "stock/saveStock.do";
		var inData      = "gds_user=gds_user ds_stock=ds_stock:U";
		var outData     = "";
		var sParam      = "";
		var callBackFnc = "fnCallback";
		
		this.gfnTransaction(strSvcId ,
							strSvcUrl ,
							inData ,
							outData ,
							sParam,
							callBackFnc);
};

this.groupLoad = function ()
{
	
 	var strSvcId    = "searchGroup";
	var strSvcUrl   = "stock/loadGroup.do";
	var inData      = "gds_user=gds_user";
	var outData     = "ds_group=ds_group";
	var sParam      = "";
	var callBackFnc = "fnCallback";
	var isAsync   	= true;
	
	this.gfnTransaction(strSvcId , 		
						strSvcUrl , 	
						inData , 		
						outData , 		
						sParam, 		
						callBackFnc, 	
						isAsync); 		
}


/*********transactionCallback***********************/

this.fnCallback = function (svcID, errorCode, errorMsg)
{	
	if(svcID == "searchStock"){
		this.ds_stock.set_enableevent(false);
		this.ds_stock.addColumn("CHK_DEL","string");
		this.ds_stock.addColumn("GROUP_NAME", "string");
		this.ds_stock.addColumn("UNIT_NAME", "string");
		for(var i=0; i<this.ds_stock.rowcount; i++) {
			var gid = this.ds_stock.getColumn(i, "GROUP_ID");
			var uid = this.ds_stock.getColumn(i, "UNIT_ID");
			
			var gname = this.ds_group.lookup("GROUP_ID", gid, "GROUP_NAME");
			var gcode = this.ds_group.lookup("GROUP_ID",gid, "GROUP_CODE");
			var uname = this.ds_unit.lookup("ID", uid, "UNIT");
			gname = gname +" : "+ gcode|| "전체"
			uname = uname || "₩"
			this.ds_stock.setColumn(i, "GROUP_NAME", gname);
			this.ds_stock.setColumn(i, "UNIT_NAME", uname);
			this.ds_stock.setColumn(i,"CHK_DEL","0");
		}
		
		this.ds_stock.set_enableevent(true);
		this.fnPagingSetting();
		
		
		
	}
	if(svcID == "saveStock"){
		this.fnPageInit();
	}
	if(svcID == "searchGroup"){
		trace("helejeoifojoeijfoie");
		this.fnPageInit();
	}
	if(svcID == "loadAi"){
		this.ds_config.addColumn("CONFIG_KEY","string");
		this.ds_config.addColumn("USER_ID","string");
		
		this.chkAIMODE.value = this.ds_config.getColumn(0,"CONFIG_VALUE");
	}
};	


this.fnPagingCallback = function(nPage, nRecordsOffset)
{
 	this.fvPage = nPage; 				
 	this.fvRecordsOffset = nRecordsOffset;
	
	this.stockLoad();
};


this.fnPagingSetting = function ()
{
	this.fvTotalCount = nexacro.toNumber(this.ds_pagingInfo.getColumn("totalCount")); //전체로우갯수
	//create page 
	this.Div00.form.divPage.form.fnCreatePage("fnPagingCallback",
									this.fvTotalCount,
									this.fvRecords,
									this.fvPage);									
};


this.editSearch_onkeyup = function(obj:nexacro.Edit,e:nexacro.KeyEventInfo)
{
	if(e.keycode == "13"){
		this.stockLoad();
	}
};

this.btnSearch_onlbuttonup = function(obj:nexacro.Button,e:nexacro.MouseEventInfo)
{
	this.stockLoad();	
};

this.btnDeleteStu_onclick = function(obj:nexacro.Button,e:nexacro.ClickEventInfo)
{
	let deleteRow = this.ds_stock.extractRows("CHK_DEL=='1'");
	this.ds_stock.deleteMultiRows(deleteRow);
	
	this.saveStock();
};





this.btnSave_onclick = function(obj:nexacro.Button,e:nexacro.ClickEventInfo)
{
	this.saveNews();
};

this.chkAIMODE_onclick = function(obj:nexacro.CheckBox,e:nexacro.ClickEventInfo)
{
	this.ds_config.setColumn(0,"CONFIG_KEY","GLOBAL_AI_MODE");
	this.ds_config.setColumn(0, "CONFIG_VALUE", this.chkAIMODE.value);
	this.ds_config.setColumn(0, "USER_ID", this.fvApp.gds_user.getColumn(0, "USER_ID")); 
	
	var strSvcId    = "saveAI";
	var strSvcUrl   = "api/saveAI.do";
	var inData      = "ds_config=ds_config:u";
	var outData     = "";
	var sParam      = "";
	var callBackFnc = "fnCallback";
	var isAsync   	= true;
	
	this.gfnTransaction(strSvcId , 		
						strSvcUrl , 	
						inData , 		
						outData , 		
						sParam, 		
						callBackFnc, 	
						isAsync); 	
};

this.loadAI =function()
{
	var strSvcId    = "loadAi";
	var strSvcUrl   = "api/loadAI.do";
	var inData      = "gds_user=gds_user";
	var outData     = "ds_config=ds_config";
	var sParam      = "";
	var callBackFnc = "fnCallback";
	var isAsync   	= true;
	
	this.gfnTransaction(strSvcId , 		
						strSvcUrl , 	
						inData , 		
						outData , 		
						sParam, 		
						callBackFnc, 	
						isAsync); 
}
]]></Script>
  </Form>
</FDL>

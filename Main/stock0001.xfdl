<?xml version="1.0" encoding="utf-8"?>
<FDL version="2.1">
  <Form id="stock0001" width="1535" height="65" titletext="header" onload="stock0001_onload">
    <Layouts>
      <Layout height="65" mobileorientation="landscape" width="1535">
        <Static id="Static00" taborder="0" left="0" top="0" right="0" bottom="1" background="white" boxShadow="0px 4px 100px 100px #eaeaea"/>
        <Static id="StaLogo" taborder="1" text="CLASSTOCK" left="50" top="12" width="181" cssclass="sta_header_logo" height="40"/>
        <Button id="btnLogin" taborder="2" text="로그인" top="12" right="50" width="115" onclick="btnLogin_onclick" cssclass="btn_header_login" height="40"/>
      </Layout>
    </Layouts>
    <Script type="xscript5.1"><![CDATA[
this.btnLogin_onclick = function(obj:nexacro.Button,e:nexacro.ClickEventInfo)
{
	if(this.btnLogin.text == "로그인"){
		this.parent.parent.divLeft.width = 0; 
		this.parent.parent.divMain.left = "divLeft: -1";
		this.parent.parent.divMain.url = "Login::stock0010.xfdl";
	}
};

this.stock0001_onload = function(obj:nexacro.Form,e:nexacro.LoadEventInfo)
{
	var fvApp = nexacro.getApplication();
	if(fvApp.gds_user.rowcount != "0"){
		this.btnLogin.text = "로그아웃";
		this.btnLogin.cssclass = "btn_header_logOut";
	}
	else {
		this.btnLogin.text = "로그인";
		this.btnLogin.cssclass = "btn_header_login";
	}
};
]]></Script>
  </Form>
</FDL>

<?xml version="1.0" encoding="utf-8"?>
<FDL version="2.1">
  <Form id="stockSub5021" width="260" height="160" titletext="dashBoard stockList">
    <Layouts>
      <Layout height="160" width="260">
        <Div id="divChart" taborder="0" left="21" top="58" width="217" height="89" url="MobileSub::stockSub5023.xfdl" text="" background="#fcf9f7"/>
        <Static id="staTitle" taborder="1" text="키즈 전자 " left="25" top="8" width="69" height="42" color="black" font="bold 14px/normal &quot;Malgun Gothic&quot;"/>
        <MaskEdit id="maskValue" taborder="2" left="170" top="15" width="84" height="28" format="#,##0" enable="true" readonly="true" textAlign="left" border="0px none" font="bold 14px/normal &quot;Malgun Gothic&quot;" color="black" displaynulltext="0" cssclass="mask_money" value="6528255"/>
        <Static id="staUnit" taborder="3" text="₩" left="140" top="12" height="33" color="black" font="bold 14px/normal &quot;Malgun Gothic&quot;" right="81" textAlign="right"/>
        <Static id="staRate" taborder="4" text="▲16.2%" left="198" top="40" width="46" height="21" color="#ff0100" font="bold 10px/normal &quot;Malgun Gothic&quot;" textAlign="right"/>
        <Static id="staTicker" taborder="5" text="kscu" left="25" top="43" width="27" height="15" color="#9b9b9b" font="10px/normal &quot;Malgun Gothic&quot;"/>
        <Button id="btnClick" taborder="6" left="0" top="0" cssclass="btn_transParent" right="0" bottom="0" onclick="btnClick_onclick" text=""/>
      </Layout>
    </Layouts>
    <Script type="xscript5.1"><![CDATA[this.fn_initCard = function(objDs, nRow) 
{
    this.staTitle.text=objDs.getColumn(nRow, "TITLE");
    this.staTicker.text=objDs.getColumn(nRow, "TICKER_SYMBOL");
   
	
	var value = objDs.getColumn(nRow, "CURRENT_VALUE");
	let tLength = nexacro.getTextSize(String(value), "bold 18px/normal Malgun Gothic");
	this.maskValue.width = tLength.nx+30;
	this.maskValue.value = value;
	
		
	var unitId = objDs.getColumn(nRow, "UNIT_ID");
	var nTargetRow = this.ds_unit.findRow("ID", unitId);
	if (nTargetRow != -1) {
		var unitName = this.ds_unit.getColumn(nTargetRow, "UNIT");
		this.staUnit.text=unitName;
	} else {
		this.staUnit.text="₩"; 
	}
    
	var findRate = objDs.getColumn(nRow, "CALCULATED_RATE");
    var rateNum = parseFloat(findRate);
    var color = (rateNum == 0 ? "#000000" : (rateNum > 0 ? "#ff0100" : "#0062ff"));
	var prefix = (findRate > 0) ? "▲" : (findRate < 0 ? "▼" : "");
	
    this.staRate.text=prefix + Math.abs(findRate) + "%";
    this.staRate.color=color;
    
    var sStockType = objDs.getColumn(nRow, "STOCK_TYPE");
    if (sStockType == "R") { //기록형
        this.divChart.set_url("MobileSub::stockSub5023.xfdl");
    } 
    else if (sStockType == "S") {//주식형
        this.divChart.set_url("MobileSub::stockSub5024.xfdl");
    }
	
	this.divChart.u_nRow = nRow;
	this.divChart.u_stockId = objDs.getColumn(nRow, "STOCK_ID");
	if(this.divChart.form.fnCreateChart){
		
		this.divChart.form.fnCreateChart();
	}
    
    this.btnClick.u_Row = nRow;
	this.resetScroll();
};

this.btnClick_onclick = function(obj, e)
{
    this.parent.parent.fn_divClick(obj.u_Row);
};]]></Script>
    <Objects>
      <Dataset id="ds_unit">
        <ColumnInfo>
          <Column id="ID" type="INT" size="256"/>
          <Column id="UNIT" type="STRING" size="256"/>
        </ColumnInfo>
        <Rows>
          <Row>
            <Col id="ID">1</Col>
            <Col id="UNIT">Kg</Col>
          </Row>
          <Row>
            <Col id="ID">2</Col>
            <Col id="UNIT">개</Col>
          </Row>
          <Row>
            <Col id="ID">3</Col>
            <Col id="UNIT">걸음</Col>
          </Row>
        </Rows>
      </Dataset>
    </Objects>
  </Form>
</FDL>
